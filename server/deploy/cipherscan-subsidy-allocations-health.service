[Unit]
Description=Verify historical subsidy allocation maintenance and canonical coverage
After=network-online.target postgresql.service
[Service]
Type=oneshot
WorkingDirectory=/root/cipherscan
Environment=NODE_PATH=/root/cipherscan/server/api/node_modules
EnvironmentFile=/etc/cipherscan/subsidy-allocations.env
StateDirectory=cipherscan-subsidy-allocations
StateDirectoryMode=0700
ExecStart=/usr/bin/node server/jobs/check-subsidy-allocations.js
TimeoutStartSec=60
TimeoutStopSec=5
Nice=15
CPUWeight=10
IOWeight=10
MemoryMax=256M
UMask=0077
