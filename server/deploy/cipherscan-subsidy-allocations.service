[Unit]
Description=Maintain canonical historical subsidy allocations for actual miner receipts
After=network-online.target postgresql.service
ConditionPathExists=/etc/cipherscan/subsidy-allocations.env
[Service]
Type=oneshot
WorkingDirectory=/root/cipherscan
Environment=NODE_PATH=/root/cipherscan/server/api/node_modules
EnvironmentFile=/etc/cipherscan/subsidy-allocations.env
ExecStart=/usr/bin/node server/jobs/maintain-subsidy-allocations.js
TimeoutStartSec=60
Nice=15
CPUWeight=10
IOWeight=10
MemoryMax=256M
UMask=0077
